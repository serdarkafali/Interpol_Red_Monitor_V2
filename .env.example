# ----------------------------------------------------------------------------
# Örnek ortam değişkenleri. Bu dosyayı ".env" adıyla kopyalayıp değerleri
# düzenleyin. ".env" dosyası git'e girmez; bu örnek dosya girer.
# ----------------------------------------------------------------------------

# --- collector ---------------------------------------------------------------
# Interpol red notice API'sinin taban adresi
COLLECTOR_INTERPOL_API_BASE_URL=https://ws-public.interpol.int/notices/v1/red

# İstekler arasında beklenecek rastgele sürenin alt ve üst sınırı (saniye)
COLLECTOR_REQUEST_DELAY_MIN_SECONDS=5.0
COLLECTOR_REQUEST_DELAY_MAX_SECONDS=8.0

# true: Kafka'ya hiçbir şey yazılmaz, yalnızca kaç olay gönderileceği loglanır.
# Gerçek Interpol verisini Kafka'ya yazmak için bilerek false yapın.
COLLECTOR_DRY_RUN=true

# Taramalar arası durum dosyalarının klasörü (Docker'da /var/lib/collector volume'u)
COLLECTOR_STATE_DIR=var/collector

# Liste taramasının aralığı ve bir kaydın detayının en erken yeniden çekilme süresi (saat)
COLLECTOR_LIST_SCAN_INTERVAL_HOURS=6
COLLECTOR_DETAIL_REFRESH_HOURS=12

# Bir taramada bilinen kayıtların en fazla bu oranı kaldırılabilir; aşılırsa hiçbiri (ADR 0006)
COLLECTOR_MAX_REMOVED_FRACTION=0.05

# Log seviyesi: DEBUG, INFO, WARNING, ERROR
COLLECTOR_LOG_LEVEL=INFO

# Log formatı: json (production, ELK için) veya console (geliştirme, renkli)
COLLECTOR_LOG_FORMAT=json

# --- database (docker-compose.yml) -------------------------------------------
# Yerel geliştirme veritabanının kullanıcısı, şifresi ve adı. Şifreyi .env içinde
# değiştirin; buradaki değer sadece örnektir.
POSTGRES_USER=interpol
POSTGRES_PASSWORD=change-me
POSTGRES_DB=interpol
# Bilgisayarınızda başka bir PostgreSQL 5432'yi kullanıyorsa 5433 yapın.
POSTGRES_PORT=5432

# --- database (uygulama ve migration'lar) ------------------------------------
# "+psycopg" kısmı SQLAlchemy'ye psycopg 3 sürücüsünü kullanmasını söyler.
DATABASE_URL=postgresql+psycopg://interpol:change-me@localhost:5432/interpol

# --- kafka (docker-compose.yml) ----------------------------------------------
# Bilgisayarınızda 9092 doluysa değiştirin; uygulamalar bu porta bağlanır.
KAFKA_PORT=9092
# Uygulamaların Kafka adresi; collector COLLECTOR_KAFKA_BOOTSTRAP_SERVERS ile ezebilir.
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
