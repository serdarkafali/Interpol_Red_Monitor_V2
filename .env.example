# ----------------------------------------------------------------------------
# Örnek ortam değişkenleri. Bu dosyayı ".env" adıyla kopyalayıp değerleri
# düzenleyin. ".env" dosyası git'e girmez; bu örnek dosya girer.
# ----------------------------------------------------------------------------

# --- collector ---------------------------------------------------------------
# Interpol red notice API'sinin taban adresi
COLLECTOR_INTERPOL_API_BASE_URL=https://ws-public.interpol.int/notices/v1/red

# İstekler arasında beklenecek rastgele sürenin alt ve üst sınırı (saniye)
COLLECTOR_REQUEST_DELAY_MIN_SECONDS=5.0
COLLECTOR_REQUEST_DELAY_MAX_SECONDS=8.0

# true: Kafka'ya hiçbir şey yazılmaz, yalnızca kaç olay gönderileceği loglanır.
# Gerçek Interpol verisini Kafka'ya yazmak için bilerek false yapın.
COLLECTOR_DRY_RUN=true

# Taramalar arası durum dosyalarının klasörü (Docker'da /var/lib/collector volume'u)
COLLECTOR_STATE_DIR=var/collector

# Liste taramasının aralığı ve bir kaydın detayının en erken yeniden çekilme süresi (saat)
COLLECTOR_LIST_SCAN_INTERVAL_HOURS=6
COLLECTOR_DETAIL_REFRESH_HOURS=12

# Bir taramada bilinen kayıtların en fazla bu oranı kaldırılabilir; aşılırsa hiçbiri (ADR 0006)
COLLECTOR_MAX_REMOVED_FRACTION=0.05

# Log seviyesi: DEBUG, INFO, WARNING, ERROR
COLLECTOR_LOG_LEVEL=INFO

# Log formatı: json (production, ELK için) veya console (geliştirme, renkli)
COLLECTOR_LOG_FORMAT=json

# --- ingestor ----------------------------------------------------------------
# Veritabanı ve Kafka adresleri yerelde aşağıdaki ortak DATABASE_URL ve
# KAFKA_BOOTSTRAP_SERVERS değişkenlerinden okunur; INGESTOR_ önekiyle ezilebilir.
# Docker'da docker-compose.yml bu adresleri kendisi verir.

# true: content_hash karşılaştırması kapanır, her observed olayı yeniden yazılır.
# Yalnızca normalizasyon düzeltmesinden sonra olayları yeniden işlemek için (ADR 0008).
INGESTOR_IGNORE_CONTENT_HASH=false

# Log seviyesi ve formatı (collector ile aynı seçenekler)
INGESTOR_LOG_LEVEL=INFO
INGESTOR_LOG_FORMAT=json

# --- database (docker-compose.yml) -------------------------------------------
# Yerel geliştirme veritabanının kullanıcısı, şifresi ve adı. Şifreyi .env içinde
# değiştirin; buradaki değer sadece örnektir. Compose şifreyi bir bağlantı URL'sine
# koyduğu için içinde @ : / ? # gibi URL karakterleri olmamalı.
POSTGRES_USER=interpol
POSTGRES_PASSWORD=change-me
POSTGRES_DB=interpol
# Bilgisayarınızda başka bir PostgreSQL 5432'yi kullanıyorsa 5433 yapın.
POSTGRES_PORT=5432

# Web arayüzünün salt okunur veritabanı kullanıcısı (ADR 0013). migrate adımı bu adla ve
# şifreyle, yalnızca okuyabilen bir kullanıcı oluşturur; şifre boşsa bu adım atlanır.
# Şifrede URL karakterleri (@ : / ? #) kullanmayın.
WEB_DATABASE_USER=web
WEB_DATABASE_PASSWORD=change-me-web
# Web arayüzüne girişte tarayıcının soracağı kullanıcı adı ve şifre (ADR 0013).
# Yalnızca İngilizce harf, rakam ve işaret kullanın: tarayıcının gönderdiği şifre ASCII
# olarak çözülür, ş ğ ü gibi harfler girişi imkânsız kılar.
WEB_USERNAME=admin
WEB_PASSWORD=change-me-login

# --- database (uygulama ve migration'lar) ------------------------------------
# "+psycopg" kısmı SQLAlchemy'ye psycopg 3 sürücüsünü kullanmasını söyler.
DATABASE_URL=postgresql+psycopg://interpol:change-me@localhost:5432/interpol

# --- kafka (docker-compose.yml) ----------------------------------------------
# Bilgisayarınızda 9092 doluysa değiştirin; uygulamalar bu porta bağlanır.
KAFKA_PORT=9092
# Uygulamaların Kafka adresi; collector COLLECTOR_KAFKA_BOOTSTRAP_SERVERS ile ezebilir.
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# Fotoğraf deposu (SeaweedFS, S3 API; ADR 0011). Değerleri kendiniz belirleyin.
STORAGE_ACCESS_KEY=change-me
STORAGE_SECRET_KEY=change-me-too
STORAGE_PORT=8333

# --- face-worker -------------------------------------------------------------
# Veritabanı adresi ve depo anahtarları DATABASE_URL ve STORAGE_* değişkenlerinden
# okunur; FACE_WORKER_ önekiyle ezilebilir. Docker'da docker-compose.yml verir.
# Docker dışında depo adresi: http://localhost:8333 (varsayılan).
# Uçtan uca denemede sahte resim sunucusunu göstermek için değiştirilir; gerçek
# Interpol'den indirme ayrıca verilecek bir karardır (ADR 0011).
FACE_WORKER_INTERPOL_BASE_URL=https://ws-public.interpol.int/notices/v1/red
# Yüz modelleri (ADR 0012). Docker imajı onları /app/models altına indirir; Docker
# dışında samples/models içindekileri gösterin.
# FACE_WORKER_DETECTOR_MODEL_PATH=samples/models/face_detection_yunet_2023mar.onnx
# FACE_WORKER_RECOGNIZER_MODEL_PATH=samples/models/face_recognition_sface_2021dec.onnx
FACE_WORKER_LOG_LEVEL=INFO
FACE_WORKER_LOG_FORMAT=json
